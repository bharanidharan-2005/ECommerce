del Name","value":"Sherpa Blanket-Solid"},{"@type":"PropertyValue","name":"Model Number","value":"SYNCHKG077171"},{"@type":"PropertyValue","name":"Number of Items","value":"1"},{"@type":"PropertyValue","name":"Number of Packs","value":"1"},{"@type":"PropertyValue","name":"Pattern","value":"Solid"},{"@type":"PropertyValue","name":"Product Care Instructions","value":"Do Not Bleach, Machine Wash"},{"@type":"PropertyValue","name":"Recommended Uses For Product","value":"Travel"},{"@type":"PropertyValue","name":"Seasons","value":"All"},{"@type":"PropertyValue","name":"Size","value":"Throw (50\" X 60\")"},{"@type":"PropertyValue","name":"Special Feature","value":"Cozy, Soft, Warm"},{"@type":"PropertyValue","name":"Style","value":"Modern"},{"@type":"PropertyValue","name":"Style Name","value":"Modern"},{"@type":"PropertyValue","name":"Theme","value":"Love"},{"@type":"PropertyValue","name":"Unit Count","value":"1 Count"},{"@type":"PropertyValue","name":"Water Resistance Level","value":"Not Water Resistant"}],"feature":["100% Polyester","Kindly Note: This blanket is designed to provide cozy comfort in its natural form, without any electric heating function. Perfect for those who appreciate the simple warmth and softness of a traditional blanket.","Reversible Softness: Titled the Good Housekeeping Best Bedding Awards Winner as a Fuzzy Fleece Throw, this blanket is designed with 220 GSM velvety flannel on the top and 260 GSM extremely soft Sherpa on the back, this double-sided cozy blanket offers the utmost comfort all year round.","Thick & Warm: The Bedsure Sherpa Fleece Blanket maintains the ideal balance between weight and warmth. No wires, no electricity. Enjoy being cuddled up by this soft and calming blanket whenever you're ready to snuggle up.","Versatile: This throw blanket (50\" x 60\") is the perfect accessory for your family and pets to get cozy—whether used as an addition to your kid's room, as a home decor element that coordinates with your couch, or as the designated cozy blanket bed for your pet.","Giftable: Available in multiple sizes and colors, this Sherpa blanket also comes in a festive gift-ready package, making this ultra-soft blanket perfect for your loved ones or as a surgery recovery gift.","Enhanced Durability: Made with unmatched quality, this soft blanket features neat stitching that ensures a more robust connection at the seams for improved durability. Guaranteed to resist fading and shedding."],"offers":{"@type":"Offer","url":"https://desertcart.in/products/28596325-bedsure-gentlesoft-sherpa-fleece-throw-blanket-for-couch-non-heated","priceCurrency":"INR","price":"5355.00","priceValidUntil":"2026-10-03","itemCondition":"https://schema.org/NewCondition","availability":"https://schema.org/InStock","paymentAccepted":["Visa","Mastercard","PayPal","Apple Pay","Tamara"],"deliveryMethod":["http://purl.org/goodrelations/v1#DHL","http://purl.org/goodrelations/v1#FederalExpress","http://purl.org/goodrelations/v1#UPS"],"shippingDetails":{"@type":"OfferShippingDetails","hasShippingService":{"@id":"https://desertcart.in/support/shipping"}},"hasMerchantReturnPolicy":{"@id":"https://desertcart.in/support/return"}},"membershipOffer":{"@type":"Offer","name":"Desertcart PRO Membership","description":"Unlock unlimited free international shipping, 30-day returns, and exclusive member-only deals on 100+ million products sourced from 5+ countries worldwide","price":"4999","priceCurrency":"INR","priceValidUntil":"2026-10-03","eligibleRegion":"IN","seller":{"@type":"Organization","name":"Desertcart"}}},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"does it cause static?","acceptedAnswer":{"@type":"Answer","text":"I have this blanket since Christmas 2020, I do experience static all the time. It has been washed and dried too. It doesn't bother me or my dog. We love this blanket immensely! I wanna replace all my blankets with these.\n💗💗💗\nBest gift ever! 10000%"}},{"@type":"Question","name":"Can I wash it in non-frontload washing machines? Meaning top load washing machine with agitator...","acceptedAnswer":{"@type":"Answer","text":"I washed mine in top load with agitator on the towel setting and dried it on heavy and it is just like before.  Supper soft and warm."}},{"@type":"Question","name":"Is the other side white or off white","acceptedAnswer":{"@type":"Answer","text":"It is off white"}},{"@type":"Question","name":"Is this made in china , i have always been disappointed in anything i bought from china ?","acceptedAnswer":{"@type":"Answer","text":"Hi, Winery, this sherpa blanket is made in China. Thanks!"}}]}]}</script><template id="P:5"></template><div class="ProductPage_page__aDcg2"><div class="ProductPage_main__orhmX"><div class="ProductDetailsCard_productDetails__Jjurk" data-sentry-component="ProductDetailsCard" data-sentry-source-file="ProductDetailsCard.jsx"><div><div class="ProductGallery_productGallery__uqi1m" data-sentry-component="ProductGallery" data-sentry-source-file="ProductGallery.jsx"><div class="ProductGallery_mainImageWrapper__iz175"><div class="ProductGallery_blurOverlay__fJPWR ProductGallery_hidden__fMzpl" style="background-image:url(https://m.media-amazon.com/images/I/91h2n60bxLL.jpg)"></div><img alt="Bedsure GentleSoft Sherpa Fleece Throw Blanket for Couch, Non-Heated, Thick &amp; Warm Cozy Comfort Blanket for Winter Fall, Soft Fuzzy Plush Throw Gifts for Women and Men, Grey, 50x60 Inches" data-sentry-element="Image" data-sentry-source-file="ProductGallery.jsx" width="458" height="458" decoding="async" data-nimg="1" style="color:transparent" sizes="(max-width: 768px) 100vw, 458px" srcSet="https://m.media-amazon.com/images/I/91h2n60bxLL._AC_SL640_.jpg 640w, https://m.media-amazon.com/images/I/91h2n60bxLL._AC_SL750_.jpg 750w, https://m.media-amazon.com/images/I/91h2n60bxLL._AC_SL828_.jpg 828w, https://m.media-amazon.com/images/I/91h2n60bxLL._AC_SL1080_.jpg 1080w, https://m.media-amazon.com/images/I/91h2n60bxLL._AC_SL1200_.jpg 1200w, https://m.media-amazon.com/im