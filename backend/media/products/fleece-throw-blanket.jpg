,\"Color\":\"04- Burnt Orange\"},\"B0GCJKCJHJ\":{\"Size\":\"Twin (60\\\" X 80\\\")\",\"Color\":\"04- Burnt Orange\"},\"B0GT4DV7V2\":{\"Size\":\"Cal King (112\\\" X 98\\\")\",\"Color\":\"02 - Charcoal\"},\"B0GT4KS3R2\":{\"Size\":\"Cal King (112\\\" X 98\\\")\",\"Color\":\"04 - Olive Green\"},\"B0GT4LYL1Y\":{\"Size\":\"Cal King (112\\\" X 98\\\")\",\"Color\":\"05 - Brown\"},\"B0GT4M7JTV\":{\"Size\":\"King (108\\\" X 90\\\")\",\"Color\":\"07 - Dusty Rose\"},\"B0GT4NJNH8\":{\"Size\":\"Cal King (112\\\" X 98\\\")\",\"Color\":\"02 - Light Grey\"},\"B0GT4NZPM6\":{\"Size\":\"Cal King (112\\\" X 98\\\")\",\"Color\":\"06 - White\"},\"B0GT4PQTDZ\":{\"Size\":\"Twin (60\\\" X 80\\\")\",\"Color\":\"07 - Dusty Rose\"},\"B0GT4QXKG4\":{\"Size\":\"Queen (90\\\" X 90\\\")\",\"Color\":\"07 - Dusty Rose\"},\"B0GT4QYBSN\":{\"Size\":\"Cal King (112\\\" X 98\\\")\",\"Color\":\"04 - Forest Green\"},\"B0GT4QYBSQ\":{\"Size\":\"Cal King (112\\\" X 98\\\")\",\"Color\":\"03 - Slate Blue\"},\"B0GT4T6QGJ\":{\"Size\":\"Cal King (112\\\" X 98\\\")\",\"Color\":\"05 - Camel\"},\"B0GT4TTD2K\":{\"Size\":\"Cal King (112\\\" X 98\\\")\",\"Color\":\"04 - Sage Green\"},\"B0GT4W7KVZ\":{\"Size\":\"Throw (50\\\" X 60\\\")\",\"Color\":\"07 - Dusty Rose\"},\"B0GWH43NFX\":{\"Size\":\"King (108\\\" X 90\\\")\",\"Color\":\"05 - Beige\"},\"B0GWH88662\":{\"Size\":\"King (108\\\" X 90\\\")\",\"Color\":\"06 - Bright White\"},\"B0GWH8GNY5\":{\"Size\":\"Twin (60\\\" X 80\\\")\",\"Color\":\"05 - Beige\"},\"B0GWHC3S37\":{\"Size\":\"Queen (90\\\" X 90\\\")\",\"Color\":\"05 - Beige\"},\"B0GWHC8NYH\":{\"Size\":\"Queen (90\\\" X 90\\\")\",\"Color\":\"06 - Bright White\"},\"B0GWHCB9LM\":{\"Size\":\"Throw (50\\\" X 60\\\")\",\"Color\":\"06 - Bright White\"},\"B0GWHCKZFQ\":{\"Size\":\"Twin (60\\\" X 80\\\")\",\"Color\":\"06 - Bright White\"},\"B0GWHG5RJ6\":{\"Size\":\"Throw (50\\\" X 60\\\")\",\"Color\":\"05 - Beige\"}},\"product_ids\":{\"B0158EQE2K\":22376281,\"B0158EQGGY\":726027884,\"B0158EQJSY\":28596325,\"B0158EQO4I\":259476