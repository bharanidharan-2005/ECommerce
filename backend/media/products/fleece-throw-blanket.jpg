0\\\") is the perfect accessory for your family and pets to get cozy—whether used as an addition to your kid's room, as a home decor element that coordinates with your couch, or as the designated cozy blanket bed for your pet.\",\"Giftable: Available in multiple sizes and colors, this Sherpa blanket also comes in a festive gift-ready package, making this ultra-soft blanket perfect for your loved ones or as a surgery recovery gift.\",\"Enhanced Durability: Made with unmatched quality, this soft blanket features neat stitching that ensures a more robust connection at the seams for improved durability. Guaranteed to resist fading and shedding.\"],\"offers\":{\"@type\":\"Offer\",\"url\":\"https://desertcart.in/products/28596325-bedsure-gentlesoft-sherpa-fleece-throw-blanket-for-couch-non-heated\",\"priceCurrency\":\"INR\",\"price\":\"5355.00\",\"priceValidUntil\":\"2026-10-03\",\"itemCondition\":\"https://schema.org/NewCondition\",\"availability\":\"https://schema.org/InStock\",\"paymentAccepted\":[\"Visa\",\"Mastercard\",\"PayPal\",\"Apple Pay\",\"Tamara\"],\"deliveryMethod\":[\"http://purl.org/goodrelations/v1#DHL\",\"http://purl.org/goodrelations/v1#FederalExpress\",\"http://purl.org/goodrelations/v1#UPS\"],\"shippingDetails\":{\"@type\":\"OfferShippingDetails\",\"hasShippingService\":{\"@id\":\"https://desertcart.in/support/shipping\"}},\"hasMerchantReturnPolicy\":{\"@id\":\"https://desertcart.in/support/return\"}},\"membershipOffer\":{\"@type\":\"Offer\",\"name\":\"Desertcart PRO Membership\",\"description\":\"Unlock unlimited free international shipping, 30-day returns, and exclusive member-only deals on 100+ million products sourced from 5+ countries worldwide\",\"price\":\"4999\",\"priceCurrency\":\"INR\",\"priceValidUntil\":\"2026-10-03\",\"eligibleRegion\":\"IN\",\"seller\":{\"@type\":\"Organization\",\"name\":\"Desertcart\"}}},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"does it cause static?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"I have this blanket since Christmas 2020, I do experience static all the time. It has been washed and dried too. It doesn't bother me or my dog. We love this blanket immensely! I wanna replace all my blankets with these.\\n💗💗💗\\nBest gift ever! 10000%\"}},{\"@type\":\"Question\",\"name\":\"Can I wash it in non-frontload washing machines? Meaning top load washing machine with agitator...\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"I washed mine in top load with agitator on the towel setting and dried it on heavy and it is just like before.  Supper soft and warm.\"}},{\"@type\":\"Question\",\"name\":\"Is the other side white or off white\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"It is off white\"}},{\"@type\":\"Question\",\"name\":\"Is this made in china , i have always been disappointed in anything i bought from china ?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Hi, Winery, this sherpa blanket is made in China. Thanks!\"}}]}]}"])</script><script>self.__next_f.push([1,"8:[\"$\",\"div\",null,{\"className\":\"BodyContainer_bodyWrapper__p8Z03 BodyContainer_withMaxWidth__ZdVjt\",\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$2c\"}}],\"$L2d\",\"$L2e\",\"$L2f\"]}]\n"])</script><script>self.__next_f.push([1,"c:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"Bedsure Gentlesoft Sherpa Fleece Throw Blanket For Couch Non Heated | Desertcart INDIA\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Shop Bedsure Gentlesoft Sherpa Fleece Throw Blanket For Couch Non Heated at best prices at Desertcart INDIA. ✓FREE Delivery Across INDIA. ✓EASY Returns \u0026 Exchange.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"canonical\",\"href\":\"https://www.desertcart.in/products/28596325-bedsure-gentlesoft-sherpa-fleece-throw-blanket-for-couch-non-heated\"}],[\"$\",\"link\",\"3\",{\"rel\":\"alternate\",\"hrefLang\":\"en-in\",\"href\":\"https://www.desertcart.in/produc